#include <behaviors.dtsi> // I don't know what this does
#include <dt-bindings/zmk/keys.h> // This extends the options for the keymap bindings
#include <dt-bindings/zmk/outputs.h> //This allows you to toggle between Bluetooth and USB
#include <dt-bindings/zmk/bt.h> // This extends the functions of Bluetooth
#include <dt-bindings/zmk/mouse.h> // This enables mouse controls

// Home row mods macro * This uses the HRM feature
#define HRML(k2,k3,k4) &ht LALT k2  &ht LCTRL k3  &ht LGUI k4
#define HRMR(k1,k2,k3) &ht RGUI k1  &ht RCTRL k2  &ht RALT k3

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 600  // 600 // Changes the DPI of the mouse emulator
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 1    // 10 // Changes the Scroll speed of the mouse emulator

#define BASE 0 // Base Map
#define LOWER 1 // Navigation Keys & Arrow Keys 
#define RAISE 2 // Punctuation
#define TRI 3 // Function & Bluetooth & Multimedia & Extra Layer
#define GAME 4 // Default qwerty 
#define NUMB 5 // Numpad layer 
#define BRUSH 6 // Depreaciated layer for F
#define SONE 7
#define STWO 8

&mt {
};   

/ {
        conditional_layers { // This is a feature that allows you to make layers active as long as you hold them
            compatible = "zmk,conditional-layers";
            tri_layer {
                if-layers = <LOWER RAISE>;
                then-layer = <TRI>;
            };
        };  
       combos {// This allows key combinations perform other functions
            compatible = "zmk,combos";
                combo_exit_game_layer {
                         timeout-ms = <50>;
                        layers = <GAME>; // only on game layer
                        key-positions = <0 11>; // top left and top right keys
                        bindings = <&tog GAME>; // toggle game layer off
                };
                
                combo_NUMB {
                        timeout-ms = <50>;
                        key-positions = <17 38>;
                        bindings = <&mo NUMB>;
                };

                shift_combo {
                        timeout-ms = <50>;
                        slow-release;
                        key-positions = <38 39>;
                        bindings = <&sk LSHFT>;
                };
        };

        behaviors {    
                ht: hold_tap {
                        label = "hold_tap";
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <220>;
                        quick-tap-ms = <150>;
                        global-quick-tap;
                        bindings = <&kp>, <&kp>;
                };
                
                backspacenter: mod_del {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp BSPC>, <&kp RET>;
                        mods = <(MOD_LALT|MOD_RALT)>;
                        keep-mods = <(MOD_RALT)>;
                };
                spacedelete: grave_escape {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp SPACE>, <&kp DEL>;
                        mods = <(MOD_LALT|MOD_RALT)>;
                        keep-mods = <(MOD_RALT)>;
                };
        };
        
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };
        };
};

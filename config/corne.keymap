#include <behaviors.dtsi> // I don't know what this does
#include <dt-bindings/zmk/keys.h> // This extends the options for the keymap bindings
#include <dt-bindings/zmk/outputs.h> //This allows you to toggle between Bluetooth and USB
#include <dt-bindings/zmk/bt.h> // This extends the functions of Bluetooth
#include <dt-bindings/zmk/mouse.h> // This enables mouse controls

// Home row mods macro * This uses the HRM feature
// #define HRML(k2,k3,k4) &ht LALT k2  &ht LCTRL k3  &ht LGUI k4 depreaciated version
// #define HRMR(k1,k2,k3) &ht RGUI k1  &ht RCTRL k2  &ht RALT k3 depreaciated version 
#define HRML(k1, k2, k3, k4) &ht LALT k1  &ht LCTRL k2  &ht LGUI k3  &ht LSHFT k4
#define HRMR(k1, k2, k3, k4) &ht RSHFT k1  &ht RGUI k2  &ht RCTRL k3  &ht RALT k4

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 600  // 600 // Changes the DPI of the mouse emulator
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 1    // 10 // Changes the Scroll speed of the mouse emulator

#define BASE 0 // Base Map
#define LOWER 1 // Navigation Keys & Arrow Keys 
#define RAISE 2 // Punctuation
#define TRI 3 // Function & Bluetooth & Multimedia & Extra Layer
#define GAME 4 // Default qwerty 
#define NUMB 5 // Numpad layer 
#define BRUSH 6 // Depreaciated layer for F
#define SONE 7
#define STWO 8

&mt {
};   

/ {
        chosen {
        zmk,matrix-transform = &five_column_transform;
        };
        conditional_layers { // This is a feature that allows you to make layers active as long as you hold them
            compatible = "zmk,conditional-layers";
            tri_layer {
                if-layers = <LOWER RAISE>;
                then-layer = <TRI>;
            };
        };  
       combos {// This allows key combinations perform other functions
            compatible = "zmk,combos";
                combo_exit_game_layer {
                         timeout-ms = <50>;
                        layers = <GAME>; // only on game layer
                        key-positions = <0 11>; // top left and top right keys
                        bindings = <&tog GAME>; // toggle game layer off
                };
                
                combo_NUMB {
                        timeout-ms = <50>;
                        key-positions = <17 38>;
                        bindings = <&mo NUMB>;
                };

                shift_combo {
                        timeout-ms = <50>;
                        slow-release;
                        key-positions = <38 39>;
                        bindings = <&sk LSHFT>;
                };
        };

        behaviors {    
                ht: hold_tap {
                        label = "hold_tap";
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <220>;
                        quick-tap-ms = <150>;
                        global-quick-tap;
                        bindings = <&kp>, <&kp>;
                };
                
                backspacenter: mod_del {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp BSPC>, <&kp RET>;
                        mods = <(MOD_LALT|MOD_RALT)>;
                        keep-mods = <(MOD_RALT)>;
                };
                spacedelete: grave_escape {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp SPACE>, <&kp DEL>;
                        mods = <(MOD_LALT|MOD_RALT)>;
                        keep-mods = <(MOD_RALT)>;
                };
        };
        
        keymap {
                compatible = "zmk,keymap";
        default_layer {
                         bindings = <
                // ╭──────────┬──────────┬──────────┬──────────┬──────────╮       ╭──────────┬──────────┬──────────┬──────────┬──────────╮
                // |          |          |          |          |          |       |          |          |          |          |          |
                     &kp Q      &kp W      &kp D      &kp F      &kp FSLH           &kp J      &kp U      &kp K      &kp Y      &kp SEMI
                // ├──────────┼──────────┼──────────┼──────────┼──────────┤       ├──────────┼──────────┼──────────┼──────────┼──────────┤
                // |          |          |          |          |          |       |          |          |          |          |          |
                     HRML(A,    S,         E,         T)         &kp L              &kp H    HRMR(N,      R,         I,         O)   
                // ├──────────┼──────────┼──────────┼──────────┼──────────┤       ├──────────┼──────────┼──────────┼──────────┼──────────┤
                // |          |          |          |          |          |       |          |          |          |          |          |
                     &kp G      &kp X      &kp C      &kp V      &kp Z              &kp B      &kp M      &kp P      &kp COMMA  &kp DOT 
                // ╰──────────┴──────────┼──────────┼──────────┼──────────┤       ├──────────┴──────────┴──────────┼──────────┴──────────╯
                //                       |          |          |          |       |          |          |          |
                                           &mo 7      &mo 1    &spacedelete       &backspacenter &mo 2    &kp LSHIFT
                //                       ╰──────────┴──────────┴──────────╯       ╰──────────┴──────────┴──────────╯
                        >;
                };
        
        lower_layer {
                        bindings = <
                // ╭──────────┬──────────┬──────────┬──────────┬──────────╮       ╭──────────┬──────────┬──────────┬──────────┬──────────╮
                // |  1       |  2       |  3       |  4       |  5       |       |  6       |  7       |  8       |  9       |  0       |
                      &kp N1     &kp N2     &kp N3     &kp N4     &kp N5             &kp N6     &kp N7     &kp N8     &kp N9     &kp N0 
                // ├──────────┼──────────┼──────────┼──────────┼──────────┤       ├──────────┼──────────┼──────────┼──────────┼──────────┤
                // |          |          |  HOME    |  PGUP    |  PRSQ    |       |  ESC     |  left    |  right   |  DWN     |  UP      |
                      &trans     &trans     &kp HOME   &kp PG_UP  &kp PSCRN          &kp ESC    &kp LEFT   &kp RIGHT  &kp DOWN   &kp UP  
                // ├──────────┼──────────┼──────────┼──────────┼──────────┤       ├──────────┼──────────┼──────────┼──────────┼──────────┤
                // |          |  CLCK    |  END     |  PGDN    |  SLCK    |       |  TAB     |   "      |          |          |          |
                      &trans     &kp CLCK   &kp END    &kp PG_DN  &kp SLCK           &kp TAB    &kp SQT    &trans     &trans     &trans  
                // ╰──────────┴──────────┼──────────┼──────────┼──────────┤       ├──────────┴──────────┴──────────┼──────────┴──────────╯
                //                       |          |          |          |       |  Enter   |          |          |
                                            &trans     &trans     &trans          &kp KP_ENTER  &trans     &trans
                //                       ╰──────────┴──────────┴──────────╯       ╰──────────┴──────────┴──────────╯
                        >;
                };


        raise_layer {
                        bindings = <
                // ╭──────────┬──────────┬──────────┬──────────┬──────────╮       ╭──────────┬──────────┬──────────┬──────────┬──────────╮
                // |  !       |  @       |  #       |  $       |  %       |       |  ^       |  &       |  *       |  -       |  +       |
                      &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT          &kp CARET  &kp AMPS   &kp STAR   &kp MINUS  &kp PLUS   
                // ├──────────┼──────────┼──────────┼──────────┼──────────┤       ├──────────┼──────────┼──────────┼──────────┼──────────┤
                // |          |  "|"     |  (       | {        |  [       |       |  ]       |  }       |  )       |  _       |  =       |
                      &kp BSLH  &kp PIPE   &kp LPAR  &kp LBRC   &kp LBKT            &kp RBKT   &kp RBRC   &kp RPAR   &kp UNDER  &kp EQUAL  
                // ├──────────┼──────────┼──────────┼──────────┼──────────┤       ├──────────┼──────────┼──────────┼──────────┼──────────┤
                // |          |          |          |          |          |          |       |          |          |          |          |/
                      &trans     &trans     &trans     &trans     &trans             &trans     &trans     &trans     &trans     &kp NUBS 
                // ╰──────────┴──────────┼──────────┼──────────┼──────────┤       ├──────────┴──────────┴──────────┼──────────┼──────────╯
                //                       |          |          |          |       |          |          |          |
                                            &trans     &trans     &trans             &trans     &trans     &trans
                //                       ╰──────────┴──────────┴──────────╯       ╰──────────┴──────────┴──────────╯
                        >;
                };
                
        tri_layer {
                        bindings = < 
                // ╭──────────┬──────────┬──────────┬──────────┬──────────╮       ╭──────────┬──────────┬──────────┬──────────┬──────────╮
                // |  F1      |  F2      |  F3      |  F4      |  F5      |       |  F6      |  F7      |  F8      |  F9      |  F10     |
                     &kp F1     &kp F2     &kp F3     &kp F4     &kp F5              &kp F6    &kp F7     &kp F8     &kp F9     &kp F10  
                // ├──────────┼──────────┼──────────┼──────────┼──────────┤       ├──────────┼──────────┼──────────┼──────────┼──────────┤
                // |  F11     |  F12     |          |          |          |       |  PREV    |  PLAY    |  NEXT    |  VO-     |  VO+     |
                     &kp F11    &kp F12  &out OUT_USB &out OUT_BLE &bt BT_CLR       &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOLUME_DOWN &kp C_VOL_UP 
                // ├──────────┼──────────┼──────────┼──────────┼──────────┤       ├──────────┼──────────┼──────────┼──────────┼──────────┤
                // |  BT1     |  BT2     |   BT3    | BT4      |  BT5     |       |  GAME    |          |          |          |          |
                    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &tog GAME  &trans  &trans     &trans     &trans     
                // ╰──────────┴──────────┼──────────┼──────────┼──────────┤       ├──────────┴──────────┴──────────┼──────────┴──────────╯
                //                       |          |          |          |       |          |          |          |
                                           &trans     &trans     &trans             &trans     &trans     &trans
                //                       ╰──────────┴──────────┴──────────╯       ╰──────────┴──────────┴──────────╯
                        >;
                };
        };
};
